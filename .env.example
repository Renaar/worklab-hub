# Copier ce fichier en .env, puis l'adapter. Le fichier .env n'est jamais
# versionné (il contient le PIN).

# Port du hub sur le serveur. 80 = http://172.16.0.17/
# Mettre 8080 si le filtrage de l'école bloque le port 80.
HUB_PORT=80

# PIN de modération des classements de Turbo Dactylo.
# deploy.sh refuse de démarrer tant qu'il vaut « turbo » ou « à-changer ».
TURBO_PIN=à-changer

# Facultatif : URL appelée après chaque sauvegarde réussie
# (ex. un service de surveillance). Laisser vide pour désactiver.
HEARTBEAT_URL=
